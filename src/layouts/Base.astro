---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/geist';
import '../styles/global.css';
import { SITE } from '../consts';

interface Props { titulo?: string; descripcion?: string }
const { titulo, descripcion = SITE.descripcion } = Astro.props;
const tituloCompleto = titulo ? `${titulo} — ${SITE.nombre}` : SITE.titulo;
const ruta = Astro.url.pathname;
const canonical = new URL(ruta, Astro.site);
const enProyecto = ruta.startsWith("/proyectos/");
const imagenSocial = new URL('/img/og.png', Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Portfolio de ${SITE.nombre}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Antes de pintar: activa animaciones y, si venimos de otra página, deja la cortina puesta.
      (function () {
        var d = document.documentElement;
        d.classList.add('js-motion');
        try {
          if (sessionStorage.getItem('sp-nav') === '1') { d.classList.add('is-arriving'); sessionStorage.removeItem('sp-nav'); }
          if (sessionStorage.getItem('sp-pre') === '1') d.classList.add('pre-done');
        } catch (e) {}
        // Red de seguridad: si el script de animación no arranca, se muestra todo sin efectos.
        setTimeout(function () {
          if (!d.classList.contains('motion-ready')) d.classList.remove('js-motion', 'is-arriving');
        }, 3500);
      })();
    </script>
  </head>
  <body>
    <header class:list={["site-head pad", { "head-portada": !enProyecto, "head-proyecto": enProyecto }]} data-head>
      <a href="/" class="brand" aria-label={`${SITE.nombre}, inicio`}>Sergio Plaza<span class="brand-c">©</span></a>
      {!enProyecto ? (
        <nav class="h-nav" aria-label="Principal">
          <a href="/#proyectos"><span class="h-t" data-t="Proyectos">Proyectos</span></a>
          <a href={SITE.linkedin} rel="noopener" target="_blank"><span class="h-t" data-t="LinkedIn">LinkedIn</span></a>
          <a href={SITE.github} rel="noopener" target="_blank"><span class="h-t" data-t="GitHub">GitHub</span></a>
        </nav>
      ) : (
        <div class="h-der">
          <a class="h-btn" href={SITE.linkedin} rel="noopener" target="_blank"><span class="h-t" data-t="Contacto">Contacto</span></a>
        </div>
      )}
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot" data-tone="dark">
      <div class="foot-row pad">
        <span>© {new Date().getFullYear()} {SITE.nombre}</span>
        <span class="foot-links">
          <a class="link" href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn</a>
          <a class="link" href={SITE.github} rel="noopener" target="_blank">GitHub</a>
        </span>
      </div>
    </footer>

    <div class="curtain" aria-hidden="true"></div>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  /* Cabecera: menú a los lados y nombre en el centro. Cambia de color según el fondo
     que tiene debajo y se oculta al bajar (reaparece al subir). */
  .site-head {
    position: fixed; inset: 0 0 auto; z-index: 50;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem;
    padding-block: calc(env(safe-area-inset-top, 0px) + 1.4rem) 1.4rem;
    color: var(--ink); font: 400 0.9rem var(--sans);
    transition: translate 0.8s var(--ease);
  }
  /* Velo degradado detrás para que se lea sobre cualquier imagen */
  .site-head::before { content: ''; position: absolute; inset: 0 0 -2rem; z-index: -1; pointer-events: none; background: linear-gradient(180deg, rgba(10, 10, 10, 0.75), rgba(10, 10, 10, 0)); }
  :global(html.head-hidden) .site-head { translate: 0 -120%; }
  .site-head a { text-decoration: none; }

  .brand { justify-self: start; font: 400 1.65rem/1 var(--serif); letter-spacing: -0.02em; }
  .brand-c { font: 400 0.6rem var(--sans); vertical-align: top; margin-left: 0.2rem; opacity: 0.6; }

  .h-nav { display: flex; gap: clamp(1.6rem, 3vw, 2.8rem); }
  /* Portada: solo el nombre y, a la derecha, los tres enlaces */
  .head-portada { grid-template-columns: auto 1fr; }
  .head-portada .h-nav { justify-self: end; }
  /* Proyecto: solo el nombre y Contacto, también en móvil */
  .head-proyecto { grid-template-columns: auto 1fr; }
  .head-proyecto .h-der { display: flex; }

  /* Texto que rueda hacia arriba al pasar el ratón */
  .h-t { position: relative; display: inline-block; overflow: hidden; vertical-align: bottom; line-height: 1.25; }
  .h-t::after { content: attr(data-t); position: absolute; left: 0; top: 100%; }
  .h-t, .h-t::after { transition: transform 0.6s var(--ease); }
  a:hover .h-t { transform: translateY(-100%); }
  a:hover .h-t::after { transform: translateY(0); }

  .h-der { justify-self: end; display: flex; align-items: center; gap: 1.6rem; }
  .h-btn { padding: 0.6rem 1.15rem; border-radius: 999px; background: var(--ink); color: var(--paper); transition: background-color 0.4s; }
  .h-btn:hover { background: #fff; }

  @media (max-width: 760px) {
    .site-head { grid-template-columns: auto 1fr; }
    .h-nav { justify-self: end; gap: 1.2rem; }
    .h-der { display: none; }
    .brand { font-size: 1.35rem; }
  }

  .site-foot { background: var(--navy); color: var(--on-dark); position: relative; z-index: 2; }
  .foot-row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-top: 1px solid rgba(243, 240, 232, 0.12); padding-block: 1.1rem 1.3rem; font-size: 0.76rem; color: var(--on-dark-muted); }
  .foot-links { display: flex; gap: 1.6rem; }
</style>
