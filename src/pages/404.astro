---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada">
  <section class="pad nf" data-hero>
    <p class="label" data-reveal>Error 404</p>
    <h1 class="display" data-split>Esta página <em>no existe.</em></h1>
    <a class="link" href="/" data-reveal="1">Volver al inicio <span class="arrow">→</span></a>
  </section>
</Base>
<style>
  .nf { min-height: 80vh; display: flex; flex-direction: column; justify-content: center; gap: 2rem; padding-top: 8rem; }
  h1 { font-size: clamp(3rem, 10vw, 9rem); margin: 0; }
</style>
